---
import { site, categories } from '../data/site';

const path = Astro.url.pathname;
const isProducts = path.startsWith('/products');
---

<div class="notice-bar">{site.notice}</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="返回首页">
      <span class="brand-mark">尚</span>
      <span class="brand-text">
        <strong>{site.name}</strong>
        <small>{site.enName}</small>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      <a href="/" class:list={{ active: path === '/' }}>首页</a>
      <a href="/products/" class:list={{ active: isProducts && !categories.some((c) => path.includes(c.id)) }}>全部商品</a>
      {
        categories.map((c) => (
          <a href={`/products/?category=${c.id}`} class:list={{ active: isProducts && path.includes(c.id) }}>
            {c.label}
          </a>
        ))
      }
      <a href="/about/" class:list={{ active: path.startsWith('/about') }}>关于店铺</a>
    </nav>

    <div class="header-actions">
      <a class="header-tel" href={`tel:${site.phone}`}>☎ {site.phone}</a>
    </div>
  </div>
</header>
